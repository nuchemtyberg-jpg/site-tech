modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["dig"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5100
externalPort = 3001

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workflow-engine"


[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "workflow-engine"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/sync-schema.sh && npx tsx scripts/test-workflow-engine.ts"

[[workflows.workflow]]
name = "http-api"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-http-api-tests.sh"

[agent]
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_object_storage:2.0.0", "sendgrid:1.0.0", "outlook:1.0.0", "javascript_openai_ai_integrations:2.0.0"]

[objectStorage]
defaultBucketID = "replit-objstore-8b10f27f-9687-4b65-bae8-e1f1aa64e143"

[userenv]

[userenv.shared]
APP_BASE_URL = "https://sitetech-app.replit.app"
MAILGUN_DOMAIN = "updates.sitetechnj.com"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000
